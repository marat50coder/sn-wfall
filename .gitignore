migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
**/android/local.properties
**/android/.gradle
**/android/captures/
**/android/key.properties
**/*.jks
**/*.keystore

# Firebase project configuration — never commit, pulled per environment.
**/android/app/google-services.json
**/ios/Runner/GoogleService-Info.plist

# Rust build output. The committed artefacts live at:
#   rust/drift_signal/src/sealed_data.rs  (ciphertext only, no plaintext)
#   android/app/src/main/jniLibs/{arm64-v8a,armeabi-v7a,x86_64}/libdrift_signal.so
#
# Plaintext seeds (endpoint, dev key, firebase project, JS enhancers)
# live in rust/drift_signal/seeds/entries.rs and MUST NOT be committed —
# only the .example twin ships to git.
/rust/drift_signal/target/
rust/drift_signal/seeds/entries.rs
