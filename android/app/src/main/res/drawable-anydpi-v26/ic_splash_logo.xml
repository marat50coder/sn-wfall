<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash uses an AdaptiveIconDrawable (not a flat PNG).
     This definition is intentionally identical to the launcher icon's
     mipmap-anydpi-v26/ic_launcher.xml so the splash and launcher art
     look pixel-identical on all masks. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_art"
            android:inset="14%" />
    </foreground>
</adaptive-icon>
