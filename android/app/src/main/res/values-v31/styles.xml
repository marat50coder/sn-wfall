<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash. Uses the same AdaptiveIconDrawable as the
         launcher so the two surfaces are visually identical. Flat
         PNGs are silently rejected by Android 12 (see custom_screens.md
         "Launcher icon"). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
