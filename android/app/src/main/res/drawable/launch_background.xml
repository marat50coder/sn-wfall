<?xml version="1.0" encoding="utf-8"?>
<!-- Deep-navy backdrop under the Android-11 and earlier splash. Keeps
     the launcher icon surrounded by the same colour as the Android-12+
     windowSplashScreenBackground, so no white rectangle flashes between
     the two generations (gray_part_pitfalls.md §16 Part C). -->
