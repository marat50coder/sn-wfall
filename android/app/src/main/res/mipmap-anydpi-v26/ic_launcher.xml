<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-written adaptive icon. flutter_launcher_icons is pinned to
     Android-only, legacy-mipmap mode and does NOT regenerate this
     file, so edits here survive icon regeneration. The 14% inset
     keeps the full icon2 artwork visible under every launcher mask
     (circle, squircle, teardrop) — see gray_part_pitfalls.md §16. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_art"
            android:inset="14%" />
    </foreground>
</adaptive-icon>
