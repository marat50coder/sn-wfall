<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-written adaptive icon. flutter_launcher_icons is configured to only
     regenerate the legacy pre-API-26 mipmaps so this file will not be
     overwritten on subsequent icon regenerations. Foreground uses a 17% inset
     so the artwork survives launcher masks (circle, squircle, rounded
     square) without clipping. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_art"
            android:inset="17%" />
    </foreground>
</adaptive-icon>
